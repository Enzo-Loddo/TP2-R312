---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";

// 1. Filtrage des données pour chaque espèce
const penguinsAdelie = penguins.filter(({species}) => species === "Adelie");
const penguinsGentoo = penguins.filter(({species}) => species === "Gentoo");
const penguinsChinstrap = penguins.filter(({species}) => species === "Chinstrap");

// 2. Fonction utilitaire pour éviter de répéter les options du graphique
const getPlotOptions = (data, title) => ({
  title: title,
  grid: true,
  marks: [
    Plot.dot(data, {
      x: "culmen_length_mm",
      y: "culmen_depth_mm",
      stroke: "species",
    }),
  ],
});
---

<Layout>
  <h1 class="text-2xl font-bold text-center my-4">TP2 - Les Pingouins (Slider)</h1>
  
  <!-- LIEN VERS LA MÉTHODE 1 (Une page par graphique) -->
  <div class="text-center mb-6">
    <a href="/species/Adelie" class="inline-block px-4 py-2 bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 transition-colors font-medium">
      → Voir la version "Une page par espèce" (Méthode 1)
    </a>
  </div>

  <!-- Menu avec ancres (Méthode 2) -->
  <!-- Utilisation de TailwindCSS pour le style .active comme demandé dans la consigne -->
  <nav class="menu-nav">
    <a href="#adelie" class="menu-item [&.active]:bg-red-200 [&.active]:font-bold">Adelie</a>
    <a href="#gentoo" class="menu-item [&.active]:bg-red-200 [&.active]:font-bold">Gentoo</a>
    <a href="#chinstrap" class="menu-item [&.active]:bg-red-200 [&.active]:font-bold">Chinstrap</a>
  </nav>

  <!-- Slider horizontal -->
  <div class="slider-container">
    <!-- Graphique Adelie -->
    <div id="adelie" class="item">
      <PlotFigure options={getPlotOptions(penguinsAdelie, "Espèce Adelie")} />
    </div>
    
    <!-- Graphique Gentoo -->
    <div id="gentoo" class="item">
      <PlotFigure options={getPlotOptions(penguinsGentoo, "Espèce Gentoo")} />
    </div>
    
    <!-- Graphique Chinstrap -->
    <div id="chinstrap" class="item">
      <PlotFigure options={getPlotOptions(penguinsChinstrap, "Espèce Chinstrap")} />
    </div>
  </div>

  <!-- Script d'observation (IntersectionObserver) -->
  <script>
    const menuItems = document.querySelectorAll(".menu-item");
    const items = document.querySelectorAll(".item");
    
    // Logs demandés dans la consigne
    console.log("menuItems", menuItems);
    console.log("items", items);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.getAttribute("id");
          const menuItem = document.querySelector(`.menu-item[href="#${id}"]`);
          
          if (entry.isIntersecting) {
            menuItem?.classList.add("active");
          } else {
            menuItem?.classList.remove("active");
          }
        });
      },
      { threshold: 0.5 },
    );

    items.forEach((item) => {
      observer.observe(item);
    });
  </script>
</Layout>

<style>
  /* --- STYLES DU MENU ET DU SLIDER --- */
  
  .menu-nav {
    position: sticky;
    top: 0;
    background: white;
    padding: 1rem;
    display: flex;
    justify-content: center;
    gap: 2rem;
    border-bottom: 2px solid #e5e7eb;
    z-index: 50;
  }

  .menu-item {
    padding: 0.5rem 1rem;
    text-decoration: none;
    color: #1f2937;
    border-radius: 0.375rem;
    transition: background-color 0.2s;
  }

  .slider-container {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory; /* Force l'arrêt sur chaque slide */
    height: 75vh;
    scroll-behavior: smooth; /* Défilement fluide au clic sur le menu */
    align-items: center;
  }

  /* Chaque graphique prend 100% de la largeur */
  .item {
    min-width: 100%;
    scroll-snap-align: center;
    display: flex;
    justify-content: center;
  }
  
  /* Cache la barre de défilement (esthétique) */
  .slider-container::-webkit-scrollbar {
    display: none;
  }
</style>