---
import PlotFigure from './PlotFigure.astro';
import penguins from '../assets/penguins.json';
import * as Plot from "@observablehq/plot";

const { speciesName } = Astro.props;

// Filtrage des pingouins selon l'espèce passée en paramètre
const filteredPenguins = penguins.filter((p) => p.species === speciesName);

const options = {
  title: `Espèce : ${speciesName}`,
  grid: true,
  marks: [
    Plot.dot(filteredPenguins, {
      x: "culmen_length_mm",
      y: "culmen_depth_mm",
      stroke: "species",
    }),
  ],
};
---
<PlotFigure options={options} />